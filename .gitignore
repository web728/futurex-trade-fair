.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key


# ==========================================
# JSON Files & Credentials Protection
# ==========================================

*.json

# Required project configuration
!/package.json
!/package-lock.json
!/tsconfig.json
!/jsconfig.json
!/vercel.json

# Futurex News Source Files
!/public/news/**/article.json
!/public/news/**/links.json

# Generated data - created during build
/src/data/auto-news.json
/src/data/auto-gallery.json
/src/data/auto-participants.json

# Private credentials must never be committed
futurex-trade.json
**/service-account*.json
**/serviceAccount*.json
**/credentials*.json
**/firebase-adminsdk*.json


